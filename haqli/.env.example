# ==============================================================================
# HAQLI v2.1 Environment Configuration
# Fresh clone works with ZERO API keys in DEMO_MODE=true!
# ==============================================================================

APP_ENV=development
DEMO_MODE=true
PUBLIC_BASE_URL=http://localhost:8002
CORS_ORIGINS=http://localhost:5173,http://localhost:8002,http://127.0.0.1:5173

# --- Database (SQLite dev/demo or PostgreSQL 16 prod) ---
DATABASE_URL=sqlite+aiosqlite:///./data/haqli.db

# --- Security & Cryptography ---
# Generate in prod: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=haqli-dev-jwt-secret-change-in-production-32chars
FERNET_KEY=
FERNET_KEY_ID=k1
ED25519_PRIVATE_KEY_B64=

# --- Telegram Mini App & Bot (Optional in DEMO_MODE) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=haqli_bot

# --- Advocate MSO Gate ---
ADVOCATE_INVITE_CODES=HAQLI-ADV-2026,DEMO-ADV

# --- Optional LLM Provider: null | openai | gemini | anthropic | local ---
LLM_PROVIDER=null
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_BASE_URL=
LLM_TIMEOUT_SEC=5.0

# --- Storage & Retention ---
UPLOAD_DIR=./data/uploads
PDF_DIR=./data/pdfs
RECOGNITION_RETENTION_HOURS=24
MAX_UPLOAD_MB=10
