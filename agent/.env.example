# ==============================================================================
# Lex.uz Legal AI Agent configuration
# Every value below is optional: without an LLM key the agent still answers in
# "extractive" mode (short answers quoted from the bundled official texts).
# ==============================================================================

# --- LLM (Gemini via its OpenAI-compatible endpoint by default) ---
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_FAST_MODEL=gemini-3.8-flash
# Used automatically when the primary model is unavailable or rejects the request
LLM_FALLBACK_MODEL=gemini-2.5-flash
# auto = "low" for Gemini 3.x Flash, "minimal" for Flash-Lite (Gemini 3.x rejects "minimal" on non-Lite models)
LLM_THINKING_LEVEL=auto
# Hard cap for one LLM call / max wait for the first streamed token before falling back to extractive mode
LLM_REQUEST_TIMEOUT=45
LLM_FIRST_TOKEN_TIMEOUT=20
# Other providers:
#   OpenAI:  LLM_PROVIDER=openai  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
#   Ollama:  LLM_PROVIDER=ollama  LLM_BASE_URL=http://localhost:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:14b

# --- Answers ---
# concise = short answer cards (answer, key points with [n] sources, steps, caution, follow-ups)
ANSWER_STYLE_DEFAULT=concise
ANSWER_CACHE_TTL_SEC=21600
ANSWER_CACHE_SIZE=512

# --- Retrieval ---
# The bundled open corpora (data/corpus) are indexed into SQLite FTS5 on startup (~7 s, skipped when unchanged).
AUTO_BUILD_INDEX=true
# CORPUS_DIR=./data/corpus
# Where the generated index lives (defaults to data/.cache); point it at a persistent disk in production.
# INDEX_DIR=/var/data/lex-agent
# hash = zero-dependency default (dense search stays off); local = BAAI/bge-m3 (needs the [ml] extra and ~2 GB RAM)
EMBEDDING_PROVIDER=hash
VECTOR_SEARCH_MODE=auto
# The cross-encoder is only used when sentence-transformers is installed
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
QDRANT_MODE=local

# --- Live Lex.uz lookups (only when the local index has no good match) ---
LEX_UZ_ENABLE_LIVE_FALLBACK=true
# Seconds; after a failure live lookups pause for 5 minutes so a slow lex.uz never slows every answer
LEX_UZ_LIVE_FALLBACK_TIMEOUT=4
LEX_UZ_TIMEOUT=25.0
LEX_UZ_RATE_LIMIT_RPS=2.0
LEX_UZ_USE_PLAYWRIGHT=false

# --- Reasoning ---
AGENT_MAX_HOPS=3
AGENT_TOP_K=12
AGENT_RERANK_TOP_K=8
AGENT_STRICT_CITATION_MODE=true

# --- Security & API ---
# Required (X-Admin-Token header) for /api/ingest/*; ingestion is closed when empty
ADMIN_TOKEN=
ALLOW_OPEN_INGEST=false
CORS_ORIGINS=*
DATA_DIR=./data
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
