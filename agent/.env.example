# ==============================================================================
# Lex.uz Legal AI Agent Configuration
# ==============================================================================

# --- LLM Configuration (OpenAI, OpenRouter, Gemini OpenAI-compat, or Ollama) ---
# For Gemini via OpenAI-compatible endpoint:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-2.5-pro
#   LLM_FAST_MODEL=gemini-2.5-flash
# For OpenAI:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o
#   LLM_FAST_MODEL=gpt-4o-mini
# For Local Ollama:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=qwen2.5:32b
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_FAST_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1

# --- Embeddings Configuration ---
# Options: "openai" | "local" (sentence-transformers BAAI/bge-m3) | "hash" (zero-dependency dev fallback)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Qdrant Vector Store ---
# Options: "local" (embedded disk storage, no Docker needed) | "remote" | "memory"
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lex_uz_legislation

# --- Cross-Encoder Reranker ---
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Live Lex.uz Retrieval ---
LEX_UZ_BASE_URL=https://lex.uz
LEX_UZ_TIMEOUT=25.0
LEX_UZ_RATE_LIMIT_RPS=2.0
LEX_UZ_USE_PLAYWRIGHT=false
LEX_UZ_ENABLE_LIVE_FALLBACK=true

# --- Agentic Reasoning Controls ---
AGENT_MAX_HOPS=3
AGENT_TOP_K=12
AGENT_RERANK_TOP_K=8
AGENT_STRICT_CITATION_MODE=true

# --- Storage & API ---
DATA_DIR=./data
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
