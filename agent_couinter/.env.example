# ==============================================================================
# LEX AUDITOR // Zero-Trust Red-Team Legal Evaluation Engine Configuration
# ==============================================================================

# --- Target Legal Agent (`agent/`) Connection ---
TARGET_AGENT_URL=http://localhost:8000
TARGET_AGENT_ASK_PATH=/api/ask
TARGET_AGENT_HEALTH_PATH=/api/health
TARGET_AGENT_TIMEOUT=90.0
# concise = the answer card end users see; detailed = long legal memo
TARGET_AGENT_ANSWER_STYLE=concise

# --- Independent Auditor LLM (Gemini AQ./AIza, OpenAI, or Ollama) ---
# If left empty, automatically checks `../agent/.env` as a convenience fallback.
AUDITOR_LLM_PROVIDER=gemini
AUDITOR_LLM_API_KEY=
AUDITOR_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AUDITOR_LLM_MODEL=gemini-3.8-flash
# Used automatically if the primary model is not available for your key (HTTP 404)
AUDITOR_LLM_FALLBACK_MODEL=gemini-2.5-flash
# Ignored by Gemini 3+ models (they do not accept a temperature)
AUDITOR_LLM_TEMPERATURE=0.1
AUDITOR_LLM_TIMEOUT=60

# --- Independent Verification Sources ---
LEX_UZ_BASE_URL=https://lex.uz
LEX_UZ_TIMEOUT=15.0
# Optional read-only path to the agent's generated SQLite index for millisecond fact verification.
# Leave empty to use ../agent/data/.cache/bm25_index.sqlite3 automatically.
# LOCAL_CORPUS_DB_PATH=../agent/data/.cache/bm25_index.sqlite3
ENABLE_LIVE_LEX_VERIFY=true

# --- Storage & Server ---
# DATA_DIR defaults to agent_couinter/data
# DATA_DIR=./data
API_HOST=0.0.0.0
API_PORT=8001
LOG_LEVEL=INFO
